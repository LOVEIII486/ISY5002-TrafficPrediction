{
  "dropout": 0.3,
  "blocks": 4,
  "layers": 2,
  "apt_layer": true,
  "gcn_bool": true,
  "addaptadj": true,
  "adjtype": "doubletransition",
  "bidir_adj_mx": false,
  "randomadj": true,
  "aptonly": true,
  "kernel_size": 2,
  "nhid": 32,
  "residual_channels": 32,
  "dilation_channels": 32,
  "skip_channels": 256,
  "end_channels": 512,
  "scaler": "standard",
  "load_external": false,
  "normal_external": false,
  "ext_scaler": "none",
  "add_time_in_day": false,
  "add_day_in_week": false,
  "max_epoch": 10,
  "learner": "adam",
  "learning_rate": 0.001,
  "lr_decay": false,
  "clip_grad_norm": true,
  "max_grad_norm": 5,
  "use_early_stop": false,
  "input_window": 12,
  "output_window": 12,
  "output_dim": 1,
  "device": "cpu",
  "teacher_forcing_ratio": 0,
  "use_curriculum_learning": false,
  "stgcn_train_mode": "full",
  "compatibility": [
    "np.int -> int",
    "2D-kernel Conv1d -> Conv2d"
  ]
}
