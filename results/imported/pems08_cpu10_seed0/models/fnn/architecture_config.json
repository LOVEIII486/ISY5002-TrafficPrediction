{
  "hidden_size": 128,
  "scaler": "standard",
  "load_external": true,
  "normal_external": false,
  "ext_scaler": "none",
  "add_time_in_day": false,
  "add_day_in_week": false,
  "max_epoch": 10,
  "learner": "adam",
  "learning_rate": 0.01,
  "lr_decay": true,
  "lr_scheduler": "multisteplr",
  "lr_decay_ratio": 0.1,
  "weight_decay": 0.01,
  "steps": [
    5,
    20,
    40,
    70
  ],
  "clip_grad_norm": true,
  "max_grad_norm": 5,
  "use_early_stop": true,
  "patience": 50,
  "input_window": 12,
  "output_window": 12,
  "output_dim": 1,
  "device": "cpu",
  "teacher_forcing_ratio": 0,
  "use_curriculum_learning": false,
  "stgcn_train_mode": "full"
}
